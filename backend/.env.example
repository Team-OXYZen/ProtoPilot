# DG OAuth
CLIENT_ID=
CLIENT_SECRET=

# App URLs
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:4200

# Runtime
ENVIRONMENT=development
JWT_SECRET=
LOG_MAX_TEXT_CHARS=500
# NO_COLOR=1

# LiteLLM - default model used by all agents
LITELLM_MODEL=
LITELLM_API_BASE=
LITELLM_API_KEY=

# Per-agent model overrides (optional, falls back to LITELLM_MODEL)
LITELLM_MODEL_REQUIREMENTS=
LITELLM_MODEL_ARTIFACTS=
LITELLM_MODEL_CODEGEN=
LITELLM_MODEL_CODE_REVIEW=
LITELLM_MODEL_QA=
LITELLM_MODEL_INTEGRATION=

# GitHub integration
# These OAuth app credentials can also be configured per user from
# Dashboard -> Preferences -> Connection Settings.
# Create the app in GitHub Developer settings and use:
#   Authorization callback URL: {BACKEND_URL}/integrations/github/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
GITHUB_OAUTH_SCOPE=repo

# Atlassian (Jira + Confluence) integration
# These OAuth 2.0 (3LO) app credentials can also be configured per user from
# Dashboard -> Preferences -> Connection Settings.
# Create the app in the Atlassian Developer Console and use:
#   Callback URL: {BACKEND_URL}/integrations/atlassian/oauth/callback
# Required scopes:
# read:me offline_access read:jira-user read:jira-work write:jira-work
# manage:jira-project manage:jira-configuration read:space:confluence
# write:space:confluence read:page:confluence write:page:confluence
# read:content:confluence write:content:confluence read:user:confluence
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_OAUTH_REDIRECT_URI=

# Integration destinations.
# Users can override all except GITHUB_BASE_BRANCH from Dashboard -> Preferences.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BASE_BRANCH=main
JIRA_PROJECT_KEY=
CONFLUENCE_SPACE_KEY=
CONFLUENCE_PARENT_PAGE_TITLE=

# ADK session identity (optional, defaults to "local-user" and "ProtoPilot")
USER_ID=
APP_NAME=

# Database paths (optional, defaults shown)
APP_DB_PATH=./app.db
USERS_DB_PATH=./users.db
ADK_DB_URL=sqlite+aiosqlite:///./adk_sessions.db

# Host used when generating preview URLs after docker compose up.
# Set to server's public IP or domain when deploying to cloud. (defaults to localhost).
DEPLOY_HOST=
